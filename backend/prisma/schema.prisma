// SIGTEC Consulado — Modelo de dados
// PostgreSQL (Neon) · Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Perfil {
  ADMIN
  TECNICO
  FUNCIONARIO
  DIRECCAO
}

enum TipoItem {
  EQUIPAMENTO
  SOFTWARE
  SERVICO
  CONTRATO
  INFRAESTRUTURA
  CONSUMIVEL
}

enum TipoRelacao {
  DEPENDE_DE
  ALIMENTA
  INSTALADO_EM
  LIGADO_A
  COBERTO_POR
  SUBSTITUI
}

enum EstadoActivo {
  EM_ARMAZEM
  OPERACIONAL
  EM_MANUTENCAO
  AVARIADO
  OBSOLETO
  ABATIDO
}

enum EstadoPedido {
  NOVO
  EM_ANALISE
  EM_RESOLUCAO
  AGUARDA_MATERIAL
  RESOLVIDO
  FECHADO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum EstadoProposta {
  COM_PARECER
  AGUARDA_APROVACAO
  APROVADA
  REJEITADA
}

/// Categoria configurável pelo Administrador — define ciclo de vida e campos próprios
model Categoria {
  id              String   @id @default(cuid())
  nome            String   @unique
  tipo            TipoItem @default(EQUIPAMENTO)
  icone           String?
  cicloVidaMeses  Int      @default(72)
  falhasCriticas  Int      @default(5)
  racioReparacao  Int      @default(50)
  esquemaCampos   Json?
  rotinaTarefa    String?
  rotinaMeses     Int?
  activa          Boolean  @default(true)
  criadoEm        DateTime @default(now())

  activos Activo[]
}

/// Fornecedores de equipamento, software e serviços
model Fornecedor {
  id           String     @id @default(cuid())
  nome         String     @unique
  nif          String?
  contactoNome String?
  telefone     String?
  email        String?
  apoioTecnico String?
  observacoes  String?
  activo       Boolean    @default(true)
  criadoEm     DateTime   @default(now())

  contratos Contrato[]
  itens     Activo[]
}

/// Contratos e subscrições com alertas de renovação
model Contrato {
  id                 String     @id @default(cuid())
  numero             String     @unique
  designacao         String
  tipo               String
  fornecedor         Fornecedor @relation(fields: [fornecedorId], references: [id])
  fornecedorId       String
  dataInicio         DateTime
  dataFim            DateTime?
  renovacaoAutomatica Boolean   @default(false)
  avisoDias          Int        @default(60)
  valorMensal        Decimal?   @db.Decimal(10, 2)
  slaHoras           Int?
  numeroCliente      String?
  observacoes        String?
  activo             Boolean    @default(true)
  criadoEm           DateTime   @default(now())

  itens Activo[]
}

/// Relações entre itens de configuração — base da análise de impacto
model RelacaoItem {
  id        String      @id @default(cuid())
  origem    Activo      @relation("origem", fields: [origemId], references: [id], onDelete: Cascade)
  origemId  String
  destino   Activo      @relation("destino", fields: [destinoId], references: [id], onDelete: Cascade)
  destinoId String
  tipo      TipoRelacao @default(DEPENDE_DE)
  critica   Boolean     @default(false)
  nota      String?
  criadoEm  DateTime    @default(now())

  @@unique([origemId, destinoId, tipo])
}

model Departamento {
  id      String   @id @default(cuid())
  nome    String   @unique
  users   User[]
  activos Activo[]
}

model User {
  id             String        @id @default(cuid())
  utilizador     String?       @unique
  email          String        @unique
  nome           String
  passwordHash   String
  perfil         Perfil        @default(FUNCIONARIO)
  activo         Boolean       @default(true)
  precisaTrocarPassword Boolean @default(false)
  localizacao    String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  departamentoId String?
  criadoEm       DateTime      @default(now())

  pedidosAbertos    Pedido[]               @relation("autor")
  pedidosAtribuidos Pedido[]               @relation("tecnico")
  activosAtribuidos Activo[]
  eventosPedido     EventoPedido[]
  propostasParecer  PropostaAbate[]        @relation("parecer")
  autosAprovados    AutoAbate[]
  respostas         RespostaQuestionario[]
  notificacoes      Notificacao[]
  artigos           ArtigoConhecimento[]
}

/// Item de Configuração — equipamentos, software, serviços, contratos e infraestrutura
model Activo {
  id                String        @id @default(cuid())
  numInventario     String        @unique
  tipo              TipoItem      @default(EQUIPAMENTO)
  designacao        String?
  categoria         String
  categoriaRef      Categoria?    @relation(fields: [categoriaId], references: [id])
  categoriaId       String?
  camposPersonalizados Json?
  criticidade       Int           @default(3)
  fornecedor        Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  fornecedorId      String?
  contrato          Contrato?     @relation(fields: [contratoId], references: [id])
  contratoId        String?
  marca             String
  modelo            String
  numSerie          String?
  dataAquisicao     DateTime
  fimGarantia       DateTime?
  localizacao       String
  departamento      Departamento? @relation(fields: [departamentoId], references: [id])
  departamentoId    String?
  responsavel       User?         @relation(fields: [responsavelId], references: [id])
  responsavelId     String?
  estado            EstadoActivo  @default(OPERACIONAL)
  temDisco          Boolean       @default(false)
  falhas6m          Int           @default(0)
  custoReparacao    Decimal?      @db.Decimal(10, 2)
  valorSubstituicao Decimal?      @db.Decimal(10, 2)
  criadoEm          DateTime      @default(now())

  eventos         EventoActivo[]
  pedidos         Pedido[]
  ordens          OrdemManutencao[]
  propostas       PropostaAbate[]
  relacoesOrigem  RelacaoItem[]     @relation("origem")
  relacoesDestino RelacaoItem[]     @relation("destino")
}

model EventoActivo {
  id        String   @id @default(cuid())
  activo    Activo   @relation(fields: [activoId], references: [id], onDelete: Cascade)
  activoId  String
  data      DateTime @default(now())
  descricao String
  autor     String
  tipo      String   @default("intervencao")
}

/// Catálogo de sintomas em linguagem comum — configurável pelo Administrador.
/// Permite que quem abre o pedido descreva o problema sem saber vocabulário técnico.
model Sintoma {
  id                 String     @id @default(cuid())
  grupo              String
  rotulo             String
  icone              String?
  descricaoAjuda     String?
  perguntas          Json?
  passosAutoAjuda    Json?
  prioridadeSugerida Prioridade @default(MEDIA)
  categoriaTecnica   String
  diagnosticoProvavel String?
  ordem              Int        @default(0)
  activo             Boolean    @default(true)
  vezesUsado         Int        @default(0)
  criadoEm           DateTime   @default(now())

  pedidos Pedido[]
}

model Pedido {
  id         String       @id @default(cuid())
  numero     String       @unique
  assunto    String
  descricao  String?
  categoria  String
  prioridade Prioridade   @default(MEDIA)
  estado     EstadoPedido @default(NOVO)
  slaHoras   Int          @default(24)
  autor      User         @relation("autor", fields: [autorId], references: [id])
  autorId    String
  tecnico    User?        @relation("tecnico", fields: [tecnicoId], references: [id])
  tecnicoId  String?
  activo     Activo?      @relation(fields: [activoId], references: [id])
  activoId   String?
  sintoma    Sintoma?     @relation(fields: [sintomaId], references: [id])
  sintomaId  String?
  respostas  Json?
  resolvidoPorAutoAjuda Boolean @default(false)
  criadoEm   DateTime     @default(now())
  fechadoEm  DateTime?
  satisfacao Int?
  satisfacaoComentario String?

  eventos EventoPedido[]
}

model EventoPedido {
  id        String   @id @default(cuid())
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId  String
  descricao String
  interno   Boolean  @default(false)
  autor     User?    @relation(fields: [autorId], references: [id])
  autorId   String?
  criadoEm  DateTime @default(now())
}

model OrdemManutencao {
  id           String    @id @default(cuid())
  tarefa       String
  categoria    String
  dataPrevista DateTime
  activo       Activo?   @relation(fields: [activoId], references: [id])
  activoId     String?
  concluida    Boolean   @default(false)
  concluidaEm  DateTime?
  concluidaPor String?
  observacoes  String?
  recorrenciaMeses Int?
}

model PropostaAbate {
  id           String         @id @default(cuid())
  numero       String         @unique
  motivo       String
  parecer      String
  parecerPor   User           @relation("parecer", fields: [parecerPorId], references: [id])
  parecerPorId String
  destino      String
  sanitizacao  String
  estado       EstadoProposta @default(COM_PARECER)
  motivoRejeicao String?
  activos      Activo[]
  criadoEm     DateTime       @default(now())
  auto         AutoAbate?
}

model AutoAbate {
  id            String        @id @default(cuid())
  numero        String        @unique
  data          DateTime      @default(now())
  proposta      PropostaAbate @relation(fields: [propostaId], references: [id])
  propostaId    String        @unique
  aprovadoPor   User          @relation(fields: [aprovadoPorId], references: [id])
  aprovadoPorId String
}

model ArtigoConhecimento {
  id            String   @id @default(cuid())
  titulo        String
  categoria     String
  corpo         String
  palavrasChave String?
  publicado     Boolean  @default(true)
  visualizacoes Int      @default(0)
  autor         User     @relation(fields: [autorId], references: [id])
  autorId       String
  criadoEm      DateTime @default(now())
  actualizadoEm DateTime @updatedAt
}

/// Conhecimento de resolução: padrões conhecidos por fabricante, categoria e sintoma.
/// Alimenta as sugestões apresentadas ao técnico ao abrir um pedido.
model Resolucao {
  id             String   @id @default(cuid())
  marca          String?
  categoria      String?
  sintomaChave   String
  titulo         String
  passos         Json
  pecaProvavel   String?
  tempoEstimado  Int?
  fonte          String   @default("Fabricante")
  vezesAplicada  Int      @default(0)
  vezesResolvida Int      @default(0)
  activo         Boolean  @default(true)
  criadoEm       DateTime @default(now())
}

model LogAuditoria {
  id          String   @id @default(cuid())
  quando      DateTime @default(now())
  quemNome    String
  quemPerfil  String
  accao       String
  titularNome String?
  ip          String?
}

model RespostaQuestionario {
  id          String   @id @default(cuid())
  autor       User     @relation(fields: [autorId], references: [id])
  autorId     String
  problema    String
  equipamento String?
  ferramenta  String?
  automatizar String?
  formacao    String?
  criadoEm    DateTime @default(now())
}

model Notificacao {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  titulo   String
  corpo    String?
  link     String?
  lida     Boolean  @default(false)
  criadoEm DateTime @default(now())
}
